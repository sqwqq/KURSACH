@model IEnumerable<Kursach.Models.Athlete>

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-warning text-dark mb-2 fs-6 px-3 py-1">Наши спортсмены</span>
                <h1 class="mb-0"><i class="bi bi-people me-2"></i>Спортсмены</h1>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <form asp-action="Index" method="get" class="mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-search me-1"></i>Поиск</label>
                        <input type="text" name="searchString" class="form-control" placeholder="Поиск по имени..." value="@ViewBag.CurrentFilter">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-sport me-1"></i>Вид спорта</label>
                        <select name="sportType" class="form-select" asp-items="ViewBag.SportTypes">
                            <option value="">Все виды спорта</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-sort me-1"></i>Сортировка</label>
                        <select name="sortOrder" class="form-select">
                            <option value="">По имени (А-Я)</option>
                            <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc")">По имени (Я-А)</option>
                            <option value="achievements" selected="@(ViewBag.CurrentSort == "achievements")">По достижениям (сначала много)</option>
                            <option value="achievements_desc" selected="@(ViewBag.CurrentSort == "achievements_desc")">По достижениям (сначала мало)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <div class="d-flex gap-1">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search me-1"></i>Найти
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary" title="Сбросить фильтры">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle display-4 d-block mb-3 text-muted"></i>
            <h4 class="fw-bold">Спортсмены не найдены</h4>
            <p class="mb-0">Попробуйте изменить параметры поиска.</p>
        </div>
    }

    <div class="row">
        @foreach (var athlete in Model)
        {
            <div class="col-md-4 col-xl-3 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="position-relative overflow-hidden" style="border-radius: 0.75rem 0.75rem 0 0;">
                        @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                        {
                            <img src="@athlete.PhotoUrl" class="card-img-top" alt="@athlete.FirstName @athlete.LastName" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 220px; background: linear-gradient(135deg, #1e3c72, #2a5298);">
                                <span class="text-white display-4 fw-bold">@(athlete.FirstName[0])@(athlete.LastName[0])</span>
                            </div>
                        }
                        @if (athlete.Achievements.Any())
                        {
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-primary shadow-lg fs-6 px-3 py-2">
                                    <i class="bi bi-trophy-fill me-1"></i>@athlete.Achievements.Count
                                </span>
                            </div>
                        }
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold mb-1">@athlete.FirstName @athlete.LastName</h5>
                        <p class="card-text text-muted small mb-0">
                            <i class="bi bi-sport me-1"></i>@athlete.Team?.SportType<br class="d-md-none">
                            <span class="d-none d-md-inline">| </span>
                            <i class="bi bi-people me-1"></i>@athlete.Group
                        </p>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0 text-center pb-3">
                        <a asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-primary rounded-pill px-4">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>