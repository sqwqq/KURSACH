@model Kursach.Models.Athlete
@{
    var totalAchievements = Model.Achievements?.Count() ?? 0;
    var firstPlaces = Model.Achievements?.Count(a => a.Place != null && int.TryParse(a.Place.Split(' ')[0], out var n) && n == 1) ?? 0;
    var secondPlaces = Model.Achievements?.Count(a => a.Place != null && int.TryParse(a.Place.Split(' ')[0], out var n) && n == 2) ?? 0;
    var thirdPlaces = Model.Achievements?.Count(a => a.Place != null && int.TryParse(a.Place.Split(' ')[0], out var n) && n == 3) ?? 0;
}

<div class="page-header">
    <div class="container">
        <a asp-action="Index" class="btn btn-outline-light btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i>Назад к списку
        </a>
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark mb-2 fs-6 px-3 py-1">@Model.Team?.SportType</span>
                <h1 class="mb-1">@Model.FirstName @Model.LastName</h1>
                <p class="text-white-50 mb-0"><i class="bi bi-people me-1"></i>@Model.Group <span class="mx-2">|</span> <i class="bi bi-flag me-1"></i>@Model.Team?.Name</p>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="position-relative">
                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" class="card-img-top" alt="@Model.FirstName @Model.LastName" style="height: 350px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-dark d-flex align-items-center justify-content-center" style="height: 350px;">
                            <span class="text-white display-1 fw-bold">@(Model.FirstName[0])@(Model.LastName[0])</span>
                        </div>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <p class="card-text text-muted">@Model.Bio</p>
                        <hr>
                    }
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="text-center p-3 bg-light">
                                <h4 class="mb-0 fw-bold text-primary">@Model.Height</h4>
                                <small class="text-muted">Рост (см)</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 bg-light">
                                <h4 class="mb-0 fw-bold text-primary">@Model.Weight</h4>
                                <small class="text-muted">Вес (кг)</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-bar-chart text-warning fs-3"></i>
                <h4 class="fw-bold mb-0">Статистика</h4>
                <div style="width: 40px; height: 1px; background: linear-gradient(90deg, #e9ecef, transparent);"></div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3 col-6">
                    <div class="card h-100 text-center" style="border-left: 3px solid var(--primary);">
                        <div class="card-body">
                            <i class="bi bi-award fs-1 text-primary mb-2 d-block"></i>
                            <h3 class="mb-0 fw-bold">@totalAchievements</h3>
                            <small class="text-muted">Всего достижений</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card h-100 text-center" style="border-left: 3px solid #f59e0b;">
                        <div class="card-body">
                            <i class="bi bi-trophy-fill fs-1 text-warning mb-2 d-block"></i>
                            <h3 class="mb-0 fw-bold">@firstPlaces</h3>
                            <small class="text-muted">Первых мест</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card h-100 text-center" style="border-left: 3px solid #94a3b8;">
                        <div class="card-body">
                            <i class="bi bi-star-fill fs-1 text-secondary mb-2 d-block"></i>
                            <h3 class="mb-0 fw-bold">@secondPlaces</h3>
                            <small class="text-muted">Вторых мест</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="card h-100 text-center" style="border-left: 3px solid #ef4444;">
                        <div class="card-body">
                            <i class="bi bi-award-fill fs-1 text-danger mb-2 d-block"></i>
                            <h3 class="mb-0 fw-bold">@thirdPlaces</h3>
                            <small class="text-muted">Третьих мест</small>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Achievements != null && Model.Achievements.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-white py-3">
                        <h4 class="mb-0 fw-bold">
                            <i class="bi bi-clock-history text-primary me-2"></i>Таймлайн достижений
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="position-relative" style="padding-left: 30px;">
                            <div style="position:absolute;left:10px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,#f59e0b,#3b82f6);"></div>
                            @foreach (var ach in Model.Achievements.OrderByDescending(a => a.Date))
                            {
                                var pn = 0; var ps = ach.Place ?? "";
                                if (!string.IsNullOrEmpty(ps)) int.TryParse(ps.Split(' ')[0], out pn);
                                <div class="mb-3 position-relative" style="animation:fadeIn 0.4s ease">
                                    <div style="position:absolute;left:-24px;top:4px;width:16px;height:16px;border-radius:50%;border:3px solid @(pn==1?"#f59e0b":pn==2?"#94a3b8":pn==3?"#ef4444":"#3b82f6");background:var(--card-bg);"></div>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@ach.Title</strong>
                                            <div><span class="badge bg-light text-dark border me-2">@ach.SportType</span>
                                            @if (pn == 1)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill me-1"></i>@ach.Place</span>
                                            }
                                            else if (pn == 2)
                                            {
                                                <span class="badge bg-secondary text-white"><i class="bi bi-star-fill me-1"></i>@ach.Place</span>
                                            }
                                            else if (pn == 3)
                                            {
                                                <span class="badge bg-danger text-white"><i class="bi bi-award-fill me-1"></i>@ach.Place</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@ach.Place</span>
                                            }
                                            </div>
                                        </div>
                                        <small class="text-muted"><i class="bi bi-calendar me-1"></i>@ach.Date.ToString("dd.MM.yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-4">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-trophy display-1 text-muted"></i>
                        <p class="text-muted mt-3">Нет достижений</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
