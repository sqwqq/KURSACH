@model Kursach.Models.Team

@{
    ViewData["Title"] = "Добавить команду";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Добавить команду
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Название команды</label>
                                <input asp-for="Name" class="form-control" required>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Вид спорта</label>
                                <input asp-for="SportType" class="form-control" required placeholder="Баскетбол, Волейбол...">
                                <span asp-validation-for="SportType" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Тренер</label>
                        <input asp-for="CoachName" class="form-control" required>
                        <span asp-validation-for="CoachName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Колледж</label>
                        <select asp-for="CollegeId" class="form-select" asp-items="ViewBag.Colleges" required>
                            <option value="">-- Выберите колледж --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Сохранить
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
