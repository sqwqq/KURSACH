@model Kursach.Models.Athlete
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Редактировать спортсмена";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0">
                    <i class="bi bi-pencil-square me-2"></i>Редактировать спортсмена
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Имя</label>
                                <input asp-for="FirstName" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Фамилия</label>
                                <input asp-for="LastName" class="form-control" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Группа</label>
                                <input asp-for="Group" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Команда</label>
                                <select asp-for="TeamId" class="form-select" asp-items="ViewBag.Teams" required>
                                    <option value="">-- Выберите команду --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Фото (URL)</label>
                        <input asp-for="PhotoUrl" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Биография</label>
                        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Рост (см)</label>
                                <input asp-for="Height" class="form-control" type="number">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Вес (кг)</label>
                                <input asp-for="Weight" class="form-control" type="number">
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg me-1"></i>Сохранить
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>