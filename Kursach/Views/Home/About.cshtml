@{
    ViewData["Title"] = "О нас";
}

<div class="page-header">
    <div class="container">
        <h1 class="mb-0"><i class="bi bi-info-circle me-2"></i>О нас</h1>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-3"><i class="bi bi-trophy-fill text-warning me-2"></i>PGEC Sports</h3>
                    <p class="lead text-muted">Спортивный портал Полоцкого государственного экономического колледжа</p>
                    <hr>
                    <p>Наша цель — популяризация спорта и здорового образа жизни среди студентов колледжа. Мы гордимся достижениями наших спортсменов и стремимся создать комфортную среду для развития спортивных талантов.</p>
                    <p>На платформе PGEC Sports вы можете:</p>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Узнать о лучших спортсменах колледжа</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Просмотреть достижения и награды</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Следить за новостями спортивной жизни</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Познакомиться с командами колледжа</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body text-center p-4">
                    <i class="bi bi-building display-1 text-primary"></i>
                    <h5 class="fw-bold mt-3">Полоцкий государственный экономический колледж</h5>
                    <p class="text-muted small">Основан в 1969 году</p>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-bar-chart display-1 text-warning"></i>
                    <h5 class="fw-bold mt-3">Наша статистика</h5>
                    <div class="row g-2">
                        <div class="col-6">
                            <h4 class="fw-bold text-primary mb-0">15+</h4>
                            <small class="text-muted">Видов спорта</small>
                        </div>
                        <div class="col-6">
                            <h4 class="fw-bold text-success mb-0">50+</h4>
                            <small class="text-muted">Наград</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
