@model IEnumerable<Kursach.Models.Athlete>
@{
    ViewData["Title"] = "Рейтинг спортсменов";
    var medals = new[] { "bi-trophy-fill", "bi-star-fill", "bi-award-fill" };
    var medalColors = new[] { "#f59e0b", "#94a3b8", "#ef4444" };
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-warning text-dark mb-2 fs-6 px-3 py-1">Спортивная элита</span>
                <h1 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Рейтинг спортсменов</h1>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <form method="get" class="mb-4">
        <div class="card">
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted mb-1">Вид спорта</label>
                        <select name="sportType" class="form-select" asp-items="ViewBag.SportTypes">
                            <option value="">Все виды спорта</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-funnel me-1"></i>Фильтр
                        </button>
                    </div>
                    <div class="col-md-2">
                        <a asp-action="Leaderboard" class="btn btn-outline-secondary w-100">Сброс</a>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-people display-4 d-block mb-3 text-muted"></i>
            <h4 class="fw-bold">Нет спортсменов</h4>
        </div>
    }

    @{
        var rank = 1;
    }
    @foreach (var athlete in Model)
    {
        var gold = athlete.Achievements?.Count(a => a.Place != null && a.Place.StartsWith("1 ")) ?? 0;
        var silver = athlete.Achievements?.Count(a => a.Place != null && a.Place.StartsWith("2 ")) ?? 0;
        var bronze = athlete.Achievements?.Count(a => a.Place != null && a.Place.StartsWith("3 ")) ?? 0;
        var total = athlete.Achievements?.Count ?? 0;

        <div class="card mb-3" data-aos="fade-up" data-aos-delay="@(rank * 50)">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto text-center" style="min-width: 80px;">
                        @if (rank <= 3)
                        {
                            <i class="bi @medals[rank - 1] display-5" style="color: @medalColors[rank - 1];"></i>
                            <div class="fw-bold small" style="color: @medalColors[rank - 1];">@rank место</div>
                        }
                        else
                        {
                            <div class="display-5 fw-bold text-muted">@rank</div>
                        }
                    </div>
                    <div class="col-auto">
                        @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                        {
                            <img src="@athlete.PhotoUrl" alt="" class="rounded-circle" style="width: 70px; height: 70px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary" style="width: 70px; height: 70px;">
                                <span class="text-white fw-bold fs-4">@athlete.FirstName[0]@athlete.LastName[0]</span>
                            </div>
                        }
                    </div>
                    <div class="col">
                        <h5 class="fw-bold mb-1">@athlete.FirstName @athlete.LastName</h5>
                        <div class="d-flex flex-wrap gap-2">
                            <small class="text-muted"><i class="bi bi-activity me-1"></i>@athlete.Team?.SportType</small>
                            <small class="text-muted"><i class="bi bi-people me-1"></i>@athlete.Group</small>
                            @if (athlete.Team != null)
                            {
                                <small class="text-muted"><i class="bi bi-flag me-1"></i>@athlete.Team.Name</small>
                            }
                        </div>
                    </div>
                    <div class="col-auto text-center">
                        <div class="d-flex gap-3">
                            <div class="text-center">
                                <h5 class="fw-bold mb-0 text-warning">@gold</h5>
                                <small class="text-muted">Золото</small>
                            </div>
                            <div class="text-center">
                                <h5 class="fw-bold mb-0 text-secondary">@silver</h5>
                                <small class="text-muted">Серебро</small>
                            </div>
                            <div class="text-center">
                                <h5 class="fw-bold mb-0" style="color: #ef4444;">@bronze</h5>
                                <small class="text-muted">Бронза</small>
                            </div>
                            <div class="text-center ps-3 border-start">
                                <h5 class="fw-bold mb-0 text-primary">@total</h5>
                                <small class="text-muted">Всего</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <a asp-controller="Athlete" asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        rank++;
    }
</div>
