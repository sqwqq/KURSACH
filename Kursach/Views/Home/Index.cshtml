@using Microsoft.AspNetCore.Mvc.Rendering
@using Kursach.Models
@using System.Linq
@{
    ViewData["Title"] = "Главная";
    var topAthletes = ViewBag.TopAthletes as IEnumerable<Athlete> ?? Enumerable.Empty<Athlete>();
    var latestNews = ViewBag.LatestNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    var featuredNews = ViewBag.FeaturedNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    dynamic stats = ViewBag.Stats;
}

<!-- Hero Section -->
<div class="position-relative text-white" style="background: linear-gradient(135deg, #0b1120 0%, #1a2332 50%, #0b1120 100%); min-height: 70vh; display: flex; align-items: center;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(245,158,11,0.03)" stroke-width="0.5"/></svg>') repeat; background-size: 60px 60px; opacity: 0.5; pointer-events: none;"></div>
    <div class="position-absolute" style="top: 10%; right: -10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(245,158,11,0.08) 0%, transparent 70%); border-radius: 50%;"></div>
    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-7" data-aos="fade-right">
                <div class="mb-4">
                    <span class="badge bg-accent px-3 py-2 mb-3 d-inline-flex align-items-center gap-2" style="background: rgba(245,158,11,0.15); color: var(--accent); border: 1px solid rgba(245,158,11,0.2);">
                        <i class="bi bi-lightning-fill"></i> PGEC Sports
                    </span>
                    <h1 class="display-3 fw-bold mb-3 lh-1" style="letter-spacing: -1px;">
                        Спортивные<br>
                        <span style="background: linear-gradient(135deg, var(--accent), #fbbf24); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">достижения</span> колледжа
                    </h1>
                    <p class="lead mb-4 text-white-50" style="max-width: 500px; font-weight: 400;">Мы гордимся нашими спортсменами, которые достигают вершин мастерства в различных видах спорта</p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Athlete" class="btn btn-warning fw-bold px-4 py-2 d-flex align-items-center gap-2">
                        Наши спортсмены <i class="bi bi-arrow-right"></i>
                    </a>
                    <a asp-controller="Achievement" class="btn fw-bold px-4 py-2 d-flex align-items-center gap-2" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); color: white;">
                        <i class="bi bi-trophy"></i> Достижения
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-flex justify-content-center" data-aos="fade-left" data-aos-delay="200">
                <div class="position-relative" style="width: 320px; height: 320px;">
                    <div style="width: 320px; height: 320px; background: linear-gradient(135deg, rgba(245,158,11,0.12), rgba(245,158,11,0.03)); border-radius: 50%; border: 1px solid rgba(245,158,11,0.15); display: flex; align-items: center; justify-content: center;">
                        <div style="width: 240px; height: 240px; background: linear-gradient(135deg, rgba(245,158,11,0.08), transparent); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-trophy-fill" style="font-size: 7rem; color: rgba(245,158,11,0.2);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stats Strip -->
<div class="bg-white" style="border-bottom: 1px solid rgba(0,0,0,0.04);">
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-4" data-aos="fade-up" data-aos-delay="0">
                <div class="text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width: 48px; height: 48px; background: linear-gradient(135deg, #eef2ff, #e0e7ff);">
                        <i class="bi bi-people-fill text-primary"></i>
                    </div>
                    <h3 class="fw-bold mb-0 display-5" style="color: var(--dark);">@(stats?.TotalAthletes ?? 0)</h3>
                    <small class="text-muted">Спортсменов</small>
                </div>
            </div>
            <div class="col-4" data-aos="fade-up" data-aos-delay="100">
                <div class="text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width: 48px; height: 48px; background: linear-gradient(135deg, #fffbeb, #fef3c7);">
                        <i class="bi bi-trophy-fill text-warning"></i>
                    </div>
                    <h3 class="fw-bold mb-0 display-5" style="color: var(--dark);">@(stats?.TotalAchievements ?? 0)</h3>
                    <small class="text-muted">Достижений</small>
                </div>
            </div>
            <div class="col-4" data-aos="fade-up" data-aos-delay="200">
                <div class="text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width: 48px; height: 48px; background: linear-gradient(135deg, #ecfdf5, #d1fae5);">
                        <i class="bi bi-flag-fill text-success"></i>
                    </div>
                    <h3 class="fw-bold mb-0 display-5" style="color: var(--dark);">@(stats?.TotalTeams ?? 0)</h3>
                    <small class="text-muted">Команд</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <!-- Featured News -->
    @if (featuredNews.Any())
    {
        <section class="mb-5" data-aos="fade-up">
            <div class="d-flex align-items-center gap-3 mb-4">
                <i class="bi bi-star-fill text-warning fs-4"></i>
                <h2 class="fw-bold mb-0" style="color: var(--dark);">Избранные новости</h2>
                <div class="section-line"></div>
            </div>
            <div class="row">
                @foreach (var featured in featuredNews)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 overflow-hidden">
                            @if (!string.IsNullOrEmpty(featured.ImageUrl))
                            {
                                <img src="@featured.ImageUrl" class="card-img-top" alt="@featured.Title" style="height: 250px; object-fit: cover;">
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-warning text-dark mb-2 align-self-start">
                                    <i class="bi bi-star-fill me-1"></i>Важное
                                </span>
                                <h4 class="card-title fw-bold">@featured.Title</h4>
                                <p class="card-text text-muted flex-grow-1">@(featured.Content.Length > 120 ? featured.Content.Substring(0, 120) + "..." : featured.Content)</p>
                                <a asp-controller="News" asp-action="Details" asp-route-id="@featured.Id" class="btn btn-warning fw-bold align-self-start">
                                    Читать <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Top Athletes -->
    <section class="mb-5" data-aos="fade-up">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-person-badge text-primary fs-4"></i>
                <h2 class="fw-bold mb-0" style="color: var(--dark);">Лучшие спортсмены</h2>
                <div class="section-line"></div>
            </div>
            <a asp-controller="Athlete" class="btn btn-outline-primary px-4 d-flex align-items-center gap-2">
                Все <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        @if (topAthletes.Any())
        {
            <div class="row">
                @foreach (var athlete in topAthletes.Take(4))
                {
                    <div class="col-md-6 col-xl-3 mb-4">
                        <div class="card h-100 text-center">
                            @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                            {
                                <img src="@athlete.PhotoUrl" class="card-img-top" alt="@athlete.FirstName @athlete.LastName" style="height: 220px; object-fit: cover;">
                            }
                            else
                            {
                                <div style="height: 220px; background: linear-gradient(135deg, var(--dark), #1e293b); display: flex; align-items: center; justify-content: center;">
                                    <span class="text-white display-4 fw-bold">@(athlete.FirstName[0])@(athlete.LastName[0])</span>
                                </div>
                            }
                            <div class="card-body">
                                <h5 class="fw-bold mb-1">@athlete.FirstName @athlete.LastName</h5>
                                <div class="d-flex justify-content-center gap-2 text-muted small mb-2">
                                    <span><i class="bi bi-sport me-1"></i>@athlete.Team?.SportType</span>
                                    <span>|</span>
                                    <span><i class="bi bi-people me-1"></i>@athlete.Group</span>
                                </div>
                                @if (athlete.Achievements.Any())
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill me-1"></i>@athlete.Achievements.Count достижений</span>
                                }
                            </div>
                            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                                <a asp-controller="Athlete" asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-primary w-100">
                                    Профиль <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Latest News -->
    <section class="mb-5" data-aos="fade-up">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-newspaper text-info fs-4"></i>
                <h2 class="fw-bold mb-0" style="color: var(--dark);">Последние новости</h2>
                <div class="section-line"></div>
            </div>
            <a asp-controller="News" class="btn btn-outline-info px-4 d-flex align-items-center gap-2">
                Все <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var news in latestNews.Take(3))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(news.ImageUrl))
                        {
                            <img src="@news.ImageUrl" class="card-img-top" alt="@news.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div style="height: 180px; background: linear-gradient(135deg, #f1f5f9, #e2e8f0); display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-newspaper display-3 text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge" style="background: rgba(15,23,42,0.08); color: var(--dark);">@news.Category</span>
                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@news.Date.ToString("dd.MM")</small>
                            </div>
                            <h5 class="fw-bold" style="font-size: 1rem;">@news.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@(news.Content.Length > 80 ? news.Content.Substring(0, 80) + "..." : news.Content)</p>
                            <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-primary btn-sm w-100 mt-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-book"></i> Читать
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Sport Types -->
    <section data-aos="fade-up">
        <div class="d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-grid-3x3-gap-fill text-warning fs-4"></i>
            <h2 class="fw-bold mb-0" style="color: var(--dark);">Виды спорта</h2>
            <div class="section-line"></div>
        </div>
        <div class="row g-3">
            @{
                var icons = new[] { "bi-basketball", "bi-volleyball", "bi-dribbble", "bi-water", "bi-person-running", "bi-bicycle" };
                var colors = new[] { "#3b82f6", "#f59e0b", "#22c55e", "#06b6d4", "#ef4444", "#8b5cf6" };
                var sportTypesList = (ViewBag.SportTypes as SelectList)?.ToList() ?? new List<SelectListItem>();
            }
            @for (int i = 0; i < sportTypesList.Count && i < 6; i++)
            {
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <a asp-controller="Athlete" asp-action="Index" asp-route-sportType="@sportTypesList[i].Value" class="text-decoration-none">
                        <div class="card h-100 text-center p-3">
                            <div class="rounded-3 mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background: @(colors[i % colors.Length])12;">
                                <i class="bi @icons[i] fs-3" style="color: @(colors[i % colors.Length]);"></i>
                            </div>
                            <p class="mb-0 fw-bold text-dark small">@sportTypesList[i].Text</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
</div>
