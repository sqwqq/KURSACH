@using Microsoft.AspNetCore.Mvc.Rendering
@using Kursach.Models
@{
    ViewData["Title"] = "Главная";
    var topAthletes = ViewBag.TopAthletes as IEnumerable<Athlete> ?? Enumerable.Empty<Athlete>();
    var latestNews = ViewBag.LatestNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    var featuredNews = ViewBag.FeaturedNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    dynamic stats = ViewBag.Stats;
}

<!-- Hero -->
<div class="bg-dark text-white py-5 position-relative" style="background: #1a2a5e !important;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: 
        linear-gradient(90deg, rgba(245,158,11,0.03) 1px, transparent 1px),
        linear-gradient(rgba(245,158,11,0.03) 1px, transparent 1px);
        background-size: 30px 30px; pointer-events: none;"></div>
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span style="width: 4px; height: 24px; background: #f59e0b; display: inline-block;"></span>
                    <span class="text-uppercase small fw-bold text-white-50 letter-spacing-2">PGEC Sports</span>
                </div>
                <h1 class="display-4 fw-bold mb-3">Спортивные достижения колледжа</h1>
                <p class="lead mb-4 text-white-50">Мы гордимся нашими спортсменами, которые достигают вершин мастерства в различных видах спорта</p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Athlete" class="btn btn-light fw-bold px-4">
                        <i class="bi bi-people me-2"></i>Наши спортсмены
                    </a>
                    <a asp-controller="Achievement" class="btn btn-outline-light fw-bold px-4">
                        <i class="bi bi-trophy me-2"></i>Достижения
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div style="height: 4px; background: linear-gradient(90deg, #f59e0b 0%, transparent 100%);"></div>
</div>

<!-- Stats -->
<div class="bg-white py-4" style="border-bottom: 1px solid #e9ecef;">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-4">
                <div class="py-3 position-relative">
                    <div style="width: 30px; height: 2px; background: #f59e0b; margin: 0 auto 8px;"></div>
                    <i class="bi bi-people-fill display-5 text-primary mb-2 d-block"></i>
                    <h2 class="fw-bold mb-0">@(stats?.TotalAthletes ?? 0)</h2>
                    <small class="text-muted">Спортсменов</small>
                </div>
            </div>
            <div class="col-4">
                <div class="py-3 position-relative">
                    <div style="width: 30px; height: 2px; background: #f59e0b; margin: 0 auto 8px;"></div>
                    <i class="bi bi-award-fill display-5 text-warning mb-2 d-block"></i>
                    <h2 class="fw-bold mb-0">@(stats?.TotalAchievements ?? 0)</h2>
                    <small class="text-muted">Достижений</small>
                </div>
            </div>
            <div class="col-4">
                <div class="py-3 position-relative">
                    <div style="width: 30px; height: 2px; background: #f59e0b; margin: 0 auto 8px;"></div>
                    <i class="bi bi-flag-fill display-5 text-success mb-2 d-block"></i>
                    <h2 class="fw-bold mb-0">@(stats?.TotalTeams ?? 0)</h2>
                    <small class="text-muted">Команд</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">

    <!-- Featured News -->
    @if (featuredNews.Any())
    {
        <section class="mb-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div style="width: 4px; height: 28px; background: #f59e0b;"></div>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-star-fill text-warning me-2"></i>Избранные новости
                </h2>
            </div>
            <div class="row">
                @foreach (var featured in featuredNews)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            @if (!string.IsNullOrEmpty(featured.ImageUrl))
                            {
                                <img src="@featured.ImageUrl" class="card-img-top" alt="@featured.Title" style="height: 250px; object-fit: cover;">
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-warning text-dark mb-2 align-self-start">
                                    <i class="bi bi-star-fill me-1"></i>Важное
                                </span>
                                <h4 class="card-title fw-bold">@featured.Title</h4>
                                <p class="card-text text-muted flex-grow-1">@(featured.Content.Length > 120 ? featured.Content.Substring(0, 120) + "..." : featured.Content)</p>
                                <a asp-controller="News" asp-action="Details" asp-route-id="@featured.Id" class="btn btn-warning fw-bold align-self-start">
                                    Читать далее <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Top Athletes -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 4px; height: 28px; background: #f59e0b;"></div>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-person-badge text-primary me-2"></i>Лучшие спортсмены
                </h2>
            </div>
            <a asp-controller="Athlete" class="btn btn-outline-primary px-4">
                Все спортсмены <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var athlete in topAthletes)
            {
                <div class="col-md-4 col-xl-3 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                        {
                            <img src="@athlete.PhotoUrl" class="card-img-top" alt="@athlete.FirstName @athlete.LastName" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-dark d-flex align-items-center justify-content-center" style="height: 220px;">
                                <span class="text-white display-4 fw-bold">@(athlete.FirstName[0])@(athlete.LastName[0])</span>
                            </div>
                        }
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold mb-1">@athlete.FirstName @athlete.LastName</h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-sport me-1"></i>@athlete.Team?.SportType<br class="d-md-none">
                                <span class="d-none d-md-inline">| </span>
                                <i class="bi bi-people me-1"></i>@athlete.Group
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0 text-center pb-3 pt-0">
                            <a asp-controller="Athlete" asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-primary px-4">
                                Подробнее <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Latest News -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 4px; height: 28px; background: #f59e0b;"></div>
                <h2 class="fw-bold mb-0">
                    <i class="bi bi-newspaper text-info me-2"></i>Последние новости
                </h2>
            </div>
            <a asp-controller="News" class="btn btn-outline-info px-4">
                Все новости <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var news in latestNews)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(news.ImageUrl))
                        {
                            <img src="@news.ImageUrl" class="card-img-top" alt="@news.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-newspaper display-3 text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@news.Category</span>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@news.Date.ToString("dd.MM")
                                </small>
                            </div>
                            <h5 class="card-title fw-bold" style="font-size: 1rem;">@news.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@(news.Content.Length > 80 ? news.Content.Substring(0, 80) + "..." : news.Content)</p>
                            <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-primary btn-sm w-100 mt-2">
                                <i class="bi bi-book me-1"></i>Читать далее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Sport Types -->
    <section>
        <div class="d-flex align-items-center gap-3 mb-4">
            <div style="width: 4px; height: 28px; background: #f59e0b;"></div>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-lightning text-warning me-2"></i>Виды спорта
            </h2>
        </div>
        <div class="row g-3">
            @{
                var icons = new[] { "bi-basketball", "bi-volleyball", "bi-dribbble", "bi-water", "bi-person-running", "bi-bicycle" };
                var colors = new[] { "#1e3c72", "#f59e0b", "#22c55e", "#0ea5e9", "#ef4444", "#8b5cf6" };
                var sportTypesList = (ViewBag.SportTypes as SelectList)?.ToList() ?? new List<SelectListItem>();
            }
            @for (int i = 0; i < sportTypesList.Count && i < 6; i++)
            {
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <a asp-controller="Athlete" asp-action="Index" asp-route-sportType="@sportTypesList[i].Value" class="text-decoration-none">
                        <div class="card h-100 text-center p-3">
                            <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: @(colors[i % colors.Length])15;">
                                <i class="bi @icons[i] fs-2" style="color: @(colors[i % colors.Length]);"></i>
                            </div>
                            <p class="mb-0 fw-bold text-dark small">@sportTypesList[i].Text</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
</div>
