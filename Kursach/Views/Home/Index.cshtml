@using Microsoft.AspNetCore.Mvc.Rendering
@using Kursach.Models
@{
    ViewData["Title"] = "Главная";
    var topAthletes = ViewBag.TopAthletes as IEnumerable<Athlete> ?? Enumerable.Empty<Athlete>();
    var latestNews = ViewBag.LatestNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    var featuredNews = ViewBag.FeaturedNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    dynamic stats = ViewBag.Stats;
}

<!-- Hero -->
<div class="position-relative text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);">
    <div class="position-absolute top-0 end-0 w-50 h-100 opacity-10 d-none d-md-block" style="background: radial-gradient(circle at center, #f59e0b 0%, transparent 70%);"></div>
    <div class="container py-5 position-relative">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-7">
                <div class="mb-4">
                    <span class="badge bg-warning text-dark px-3 py-2 mb-3">Добро пожаловать</span>
                    <h1 class="display-4 fw-bold mb-3 lh-1">Спортивные<br>достижения колледжа</h1>
                    <p class="lead mb-0 text-white-50" style="max-width: 500px;">Мы гордимся нашими спортсменами, которые достигают вершин мастерства в различных видах спорта</p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Athlete" class="btn btn-warning fw-bold px-4 py-2">
                        <i class="bi bi-people me-2"></i>Наши спортсмены
                    </a>
                    <a asp-controller="Achievement" class="btn btn-outline-light fw-bold px-4 py-2">
                        <i class="bi bi-trophy me-2"></i>Достижения
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-flex justify-content-center">
                <div style="width: 280px; height: 280px; background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(245,158,11,0.05)); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-trophy" style="font-size: 8rem; color: rgba(245,158,11,0.3);"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="bg-white shadow-sm py-4">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-4">
                <div class="py-2">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width: 50px; height: 50px; background: #eef2ff;">
                        <i class="bi bi-people-fill fs-3 text-primary"></i>
                    </div>
                    <h3 class="fw-bold mb-0 display-5">@(stats?.TotalAthletes ?? 0)</h3>
                    <small class="text-muted">Спортсменов</small>
                </div>
            </div>
            <div class="col-4">
                <div class="py-2">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width: 50px; height: 50px; background: #fffbeb;">
                        <i class="bi bi-award-fill fs-3 text-warning"></i>
                    </div>
                    <h3 class="fw-bold mb-0 display-5">@(stats?.TotalAchievements ?? 0)</h3>
                    <small class="text-muted">Достижений</small>
                </div>
            </div>
            <div class="col-4">
                <div class="py-2">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2" style="width: 50px; height: 50px; background: #ecfdf5;">
                        <i class="bi bi-flag-fill fs-3 text-success"></i>
                    </div>
                    <h3 class="fw-bold mb-0 display-5">@(stats?.TotalTeams ?? 0)</h3>
                    <small class="text-muted">Команд</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <!-- Featured News -->
    @if (featuredNews.Any())
    {
        <section class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-star-fill text-warning fs-3"></i>
                <h2 class="fw-bold mb-0">Избранные новости</h2>
                <div class="flex-grow-1" style="height: 1px; background: linear-gradient(90deg, #e9ecef, transparent);"></div>
            </div>
            <div class="row">
                @foreach (var featured in featuredNews)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 overflow-hidden">
                            @if (!string.IsNullOrEmpty(featured.ImageUrl))
                            {
                                <img src="@featured.ImageUrl" class="card-img-top" alt="@featured.Title" style="height: 250px; object-fit: cover;">
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-warning text-dark mb-2 align-self-start">
                                    <i class="bi bi-star-fill me-1"></i>Важное
                                </span>
                                <h4 class="card-title fw-bold">@featured.Title</h4>
                                <p class="card-text text-muted flex-grow-1">@(featured.Content.Length > 120 ? featured.Content.Substring(0, 120) + "..." : featured.Content)</p>
                                <a asp-controller="News" asp-action="Details" asp-route-id="@featured.Id" class="btn btn-warning fw-bold align-self-start">
                                    Читать далее <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Top Athletes -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary fs-3"></i>
                <h2 class="fw-bold mb-0">Лучшие спортсмены</h2>
                <div style="width: 40px; height: 1px; background: linear-gradient(90deg, #e9ecef, transparent);"></div>
            </div>
            <a asp-controller="Athlete" class="btn btn-outline-primary px-4">
                Все спортсмены <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var athlete in topAthletes)
            {
                <div class="col-md-4 col-xl-3 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                        {
                            <img src="@athlete.PhotoUrl" class="card-img-top" alt="@athlete.FirstName @athlete.LastName" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-dark d-flex align-items-center justify-content-center" style="height: 220px;">
                                <span class="text-white display-4 fw-bold">@(athlete.FirstName[0])@(athlete.LastName[0])</span>
                            </div>
                        }
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold mb-1">@athlete.FirstName @athlete.LastName</h5>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-sport me-1"></i>@athlete.Team?.SportType<br class="d-md-none">
                                <span class="d-none d-md-inline">| </span>
                                <i class="bi bi-people me-1"></i>@athlete.Group
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0 text-center pb-3 pt-0">
                            <a asp-controller="Athlete" asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-primary px-4">
                                Подробнее <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Latest News -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-newspaper text-info fs-3"></i>
                <h2 class="fw-bold mb-0">Последние новости</h2>
                <div style="width: 40px; height: 1px; background: linear-gradient(90deg, #e9ecef, transparent);"></div>
            </div>
            <a asp-controller="News" class="btn btn-outline-info px-4">
                Все новости <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var news in latestNews)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(news.ImageUrl))
                        {
                            <img src="@news.ImageUrl" class="card-img-top" alt="@news.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-newspaper display-3 text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@news.Category</span>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@news.Date.ToString("dd.MM")
                                </small>
                            </div>
                            <h5 class="card-title fw-bold" style="font-size: 1rem;">@news.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@(news.Content.Length > 80 ? news.Content.Substring(0, 80) + "..." : news.Content)</p>
                            <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-primary btn-sm w-100 mt-2">
                                <i class="bi bi-book me-1"></i>Читать далее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Sport Types -->
    <section>
        <div class="d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-grid text-warning fs-3"></i>
            <h2 class="fw-bold mb-0">Виды спорта</h2>
            <div class="flex-grow-1" style="height: 1px; background: linear-gradient(90deg, #e9ecef, transparent);"></div>
        </div>
        <div class="row g-3">
            @{
                var icons = new[] { "bi-basketball", "bi-volleyball", "bi-dribbble", "bi-water", "bi-person-running", "bi-bicycle" };
                var colors = new[] { "#3b82f6", "#f59e0b", "#22c55e", "#06b6d4", "#ef4444", "#8b5cf6" };
                var sportTypesList = (ViewBag.SportTypes as SelectList)?.ToList() ?? new List<SelectListItem>();
            }
            @for (int i = 0; i < sportTypesList.Count && i < 6; i++)
            {
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <a asp-controller="Athlete" asp-action="Index" asp-route-sportType="@sportTypesList[i].Value" class="text-decoration-none">
                        <div class="card h-100 text-center p-3">
                            <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: @(colors[i % colors.Length])15;">
                                <i class="bi @icons[i] fs-2" style="color: @(colors[i % colors.Length]);"></i>
                            </div>
                            <p class="mb-0 fw-bold text-dark small">@sportTypesList[i].Text</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
</div>
