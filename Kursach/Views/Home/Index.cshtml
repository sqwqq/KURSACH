@using Microsoft.AspNetCore.Mvc.Rendering
@using Kursach.Models
@{
    ViewData["Title"] = "Главная";
    var topAthletes = ViewBag.TopAthletes as IEnumerable<Athlete> ?? Enumerable.Empty<Athlete>();
    var latestNews = ViewBag.LatestNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    var featuredNews = ViewBag.FeaturedNews as IEnumerable<News> ?? Enumerable.Empty<News>();
    dynamic stats = ViewBag.Stats;
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-7 text-center text-lg-start">
                <span class="badge bg-warning text-dark mb-3 fs-6 px-3 py-2">Добро пожаловать в PGEC Sports</span>
                <h1 class="display-3 fw-bold mb-3">Спортивные достижения колледжа</h1>
                <p class="lead mb-4 text-white-50">Мы гордимся нашими спортсменами, которые достигают вершин мастерства в различных видах спорта</p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a asp-controller="Athlete" class="btn btn-light btn-lg fw-bold shadow-sm px-4">
                        <i class="bi bi-people me-2"></i>Наши спортсмены
                    </a>
                    <a asp-controller="Achievement" class="btn btn-outline-light btn-lg fw-bold px-4">
                        <i class="bi bi-trophy me-2"></i>Достижения
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <div class="hero-icon-wrapper">
                    <i class="bi bi-trophy hero-icon"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-bar">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-4">
                <div class="stat-card p-4 rounded-4 bg-white shadow-sm">
                    <i class="bi bi-people-fill display-4 text-primary mb-2"></i>
                    <h3 class="fw-bold mb-0 display-6">@(stats?.TotalAthletes ?? 0)</h3>
                    <small class="text-muted">Спортсменов</small>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-card p-4 rounded-4 bg-white shadow-sm">
                    <i class="bi bi-award-fill display-4 text-warning mb-2"></i>
                    <h3 class="fw-bold mb-0 display-6">@(stats?.TotalAchievements ?? 0)</h3>
                    <small class="text-muted">Достижений</small>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-card p-4 rounded-4 bg-white shadow-sm">
                    <i class="bi bi-flag-fill display-4 text-success mb-2"></i>
                    <h3 class="fw-bold mb-0 display-6">@(stats?.TotalTeams ?? 0)</h3>
                    <small class="text-muted">Команд</small>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <!-- Featured News -->
    @if (featuredNews.Any())
    {
        <section class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <h2 class="mb-0 fw-bold">
                    <i class="bi bi-star-fill text-warning me-2"></i>Избранные новости
                </h2>
                <div class="flex-grow-1" style="height: 2px; background: linear-gradient(90deg, var(--bs-warning), transparent);"></div>
            </div>
            <div class="row">
                @foreach (var featured in featuredNews)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card featured-card h-100 border-0 shadow-lg overflow-hidden">
                            @if (!string.IsNullOrEmpty(featured.ImageUrl))
                            {
                                <img src="@featured.ImageUrl" class="card-img-top" alt="@featured.Title" style="height: 250px; object-fit: cover;">
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-warning text-dark mb-2 align-self-start">
                                    <i class="bi bi-star-fill me-1"></i>Важное
                                </span>
                                <h4 class="card-title fw-bold">@featured.Title</h4>
                                <p class="card-text text-muted flex-grow-1">@(featured.Content.Length > 120 ? featured.Content.Substring(0, 120) + "..." : featured.Content)</p>
                                <a asp-controller="News" asp-action="Details" asp-route-id="@featured.Id" class="btn btn-warning fw-bold align-self-start">
                                    Читать далее <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Top Athletes -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <h2 class="mb-0 fw-bold">
                    <i class="bi bi-person-badge text-primary me-2"></i>Лучшие спортсмены
                </h2>
                <div style="height: 2px; width: 60px; background: linear-gradient(90deg, var(--bs-primary), transparent);"></div>
            </div>
            <a asp-controller="Athlete" class="btn btn-outline-primary rounded-pill px-4">
                Все спортсмены <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var athlete in topAthletes)
            {
                <div class="col-md-4 col-xl-3 mb-4">
                    <div class="card athlete-card h-100 shadow-sm border-0">
                        <div class="position-relative overflow-hidden" style="border-radius: 0.75rem 0.75rem 0 0;">
                            @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                            {
                                <img src="@athlete.PhotoUrl" class="card-img-top" alt="@athlete.FirstName @athlete.LastName" style="height: 220px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-gradient d-flex align-items-center justify-content-center" style="height: 220px; background: linear-gradient(135deg, #1e3c72, #2a5298);">
                                    <span class="text-white display-4 fw-bold">@(athlete.FirstName[0])@(athlete.LastName[0])</span>
                                </div>
                            }
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-primary shadow-lg fs-6 px-3 py-2">
                                    <i class="bi bi-trophy-fill me-1"></i>@athlete.Achievements.Count
                                </span>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold mb-1">@athlete.FirstName @athlete.LastName</h5>
                            <p class="text-muted small mb-1">
                                <i class="bi bi-sport me-1"></i>@athlete.Team?.SportType
                            </p>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-people me-1"></i>@athlete.Group
                            </p>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 text-center pb-3">
                            <a asp-controller="Athlete" asp-action="Details" asp-route-id="@athlete.Id" class="btn btn-primary rounded-pill px-4">
                                Подробнее <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Latest News -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <h2 class="mb-0 fw-bold">
                    <i class="bi bi-newspaper text-info me-2"></i>Последние новости
                </h2>
                <div style="height: 2px; width: 60px; background: linear-gradient(90deg, #0dcaf0, transparent);"></div>
            </div>
            <a asp-controller="News" class="btn btn-outline-info rounded-pill px-4">
                Все новости <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row">
            @foreach (var news in latestNews)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card news-card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(news.ImageUrl))
                        {
                            <img src="@news.ImageUrl" class="card-img-top" alt="@news.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-newspaper display-3 text-muted"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@news.Category</span>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@news.Date.ToString("dd.MM")
                                </small>
                            </div>
                            <h5 class="card-title fw-bold" style="font-size: 1rem;">@news.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@(news.Content.Length > 80 ? news.Content.Substring(0, 80) + "..." : news.Content)</p>
                            <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill mt-2">
                                <i class="bi bi-book me-1"></i>Читать далее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Sport Types -->
    <section class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-4">
            <h2 class="mb-0 fw-bold">
                <i class="bi bi-lightning text-warning me-2"></i>Виды спорта
            </h2>
            <div class="flex-grow-1" style="height: 2px; background: linear-gradient(90deg, var(--bs-warning), transparent);"></div>
        </div>
        <div class="row g-3">
            @{
                var icons = new[] { "bi-basketball", "bi-volleyball", "bi-dribbble", "bi-water", "bi-person-running", "bi-bicycle" };
                var colors = new[] { "#1e3c72", "#f59e0b", "#22c55e", "#0ea5e9", "#ef4444", "#8b5cf6" };
                var sportTypesList = (ViewBag.SportTypes as SelectList)?.ToList() ?? new List<SelectListItem>();
            }
            @for (int i = 0; i < sportTypesList.Count && i < 6; i++)
            {
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <a asp-controller="Athlete" asp-action="Index" asp-route-sportType="@sportTypesList[i].Value" class="text-decoration-none">
                        <div class="sport-type-card text-center p-4 rounded-4 shadow-sm bg-white h-100 border border-2" style="border-color: transparent !important;">
                            <div class="sport-icon-wrapper d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 70px; height: 70px; background: @(colors[i % colors.Length])15;">
                                <i class="bi @icons[i] display-5" style="color: @(colors[i % colors.Length]);"></i>
                            </div>
                            <p class="mb-0 fw-bold text-dark small">@sportTypesList[i].Text</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #1a2a5e 100%);
        padding: 100px 0;
        position: relative;
        overflow: hidden;
    }
    .hero-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.03) 0%, transparent 50%),
                    radial-gradient(circle at 80% 20%, rgba(245,158,11,0.05) 0%, transparent 50%);
    }
    .hero-icon-wrapper {
        animation: float 6s ease-in-out infinite;
    }
    .hero-icon {
        font-size: 12rem;
        color: rgba(255,255,255,0.08);
        filter: drop-shadow(0 20px 40px rgba(245,158,11,0.2));
    }
    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
    .stats-bar {
        background: white;
        padding: 2rem 0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        position: relative;
        z-index: 2;
    }
    .stat-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .stat-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }
    .athlete-card, .news-card, .sport-type-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .athlete-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
    }
    .news-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    .featured-card {
        transition: transform 0.3s ease;
    }
    .featured-card:hover {
        transform: scale(1.02);
    }
    .sport-type-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        border-color: currentColor !important;
    }
    .sport-type-card:hover .sport-icon-wrapper {
        transform: scale(1.1);
    }
    .sport-icon-wrapper {
        transition: transform 0.3s ease;
    }
    @@media (max-width: 768px) {
        .hero-section { padding: 60px 0; }
        .hero-section h1 { font-size: 2.2rem; }
        .hero-icon { font-size: 6rem; }
        .stat-card { padding: 1.5rem !important; }
    }
</style>