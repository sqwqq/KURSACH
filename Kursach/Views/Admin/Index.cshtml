@{
    ViewData["Title"] = "Админ-панель";
}

<div class="page-header">
    <div class="container">
        <h1 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Админ-панель</h1>
    </div>
</div>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Статистика -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-people fs-3 text-primary"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalAthletes</h3>
                        <small class="text-muted">Спортсменов</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                        <i class="bi bi-trophy fs-3 text-warning"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalAchievements</h3>
                        <small class="text-muted">Достижений</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3">
                        <i class="bi bi-flag fs-3 text-success"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalTeams</h3>
                        <small class="text-muted">Команд</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3">
                        <i class="bi bi-building fs-3 text-secondary"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalColleges</h3>
                        <small class="text-muted">Колледжей</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3">
                        <i class="bi bi-newspaper fs-3 text-info"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalNews</h3>
                        <small class="text-muted">Новостей</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                        <i class="bi bi-calendar-event fs-3 text-danger"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalCompetitions</h3>
                        <small class="text-muted">Соревнований</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="card text-center p-3 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="rounded-circle p-3" style="background: rgba(245,158,11,0.1);">
                        <i class="bi bi-trophy-fill fs-3" style="color: #f59e0b;"></i>
                    </div>
                    <div class="text-start">
                        <h3 class="fw-bold mb-0">@ViewBag.TotalGold</h3>
                        <small class="text-muted">Золотых медалей</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-transparent fw-bold">
                    <i class="bi bi-pie-chart me-2 text-warning"></i>Достижения по видам спорта
                </div>
                <div class="card-body">
                    <canvas id="sportChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-transparent fw-bold">
                    <i class="bi bi-bar-chart me-2 text-primary"></i>Динамика достижений
                </div>
                <div class="card-body">
                    <canvas id="trendChart" height="220"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #eef2ff;">
                        <i class="bi bi-people display-3 text-primary"></i>
                    </div>
                    <h4 class="fw-bold">Спортсмены</h4>
                    <p class="text-muted small mb-3">Управление спортсменами</p>
                    <a asp-controller="AdminAthlete" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-gear me-1"></i>Управление
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #fffbeb;">
                        <i class="bi bi-trophy display-3 text-warning"></i>
                    </div>
                    <h4 class="fw-bold">Достижения</h4>
                    <p class="text-muted small mb-3">Управление достижениями</p>
                    <a asp-controller="AdminAchievement" asp-action="Index" class="btn btn-warning px-4">
                        <i class="bi bi-gear me-1"></i>Управление
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #f0fdf4;">
                        <i class="bi bi-flag display-3 text-success"></i>
                    </div>
                    <h4 class="fw-bold">Команды</h4>
                    <p class="text-muted small mb-3">Управление командами</p>
                    <a asp-controller="AdminTeam" asp-action="Index" class="btn btn-success px-4">
                        <i class="bi bi-gear me-1"></i>Управление
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #f8fafc;">
                        <i class="bi bi-building display-3 text-secondary"></i>
                    </div>
                    <h4 class="fw-bold">Колледжи</h4>
                    <p class="text-muted small mb-3">Управление колледжами</p>
                    <a asp-controller="AdminCollege" asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-gear me-1"></i>Управление
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #fef2f2;">
                        <i class="bi bi-calendar-event display-3 text-danger"></i>
                    </div>
                    <h4 class="fw-bold">Соревнования</h4>
                    <p class="text-muted small mb-3">Управление соревнованиями</p>
                    <a asp-controller="AdminCompetition" asp-action="Index" class="btn btn-danger px-4">
                        <i class="bi bi-gear me-1"></i>Управление
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #ecfeff;">
                        <i class="bi bi-newspaper display-3 text-info"></i>
                    </div>
                    <h4 class="fw-bold">Новости</h4>
                    <p class="text-muted small mb-3">Управление новостями</p>
                    <a asp-controller="AdminNews" asp-action="Index" class="btn btn-info text-white px-4">
                        <i class="bi bi-gear me-1"></i>Управление
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-5">
            <i class="bi bi-arrow-left me-1"></i>Вернуться на сайт
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('sportChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData)),
                    backgroundColor: ['#f59e0b','#3b82f6','#10b981','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } }
                }
            }
        });
        new Chart(document.getElementById('trendChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyLabels)),
                datasets: [{
                    label: 'Достижения',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyData)),
                    backgroundColor: '#3b82f6',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
