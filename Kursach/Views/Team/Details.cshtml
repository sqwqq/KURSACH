@model Kursach.Models.Team
@{
    var sportIcons = new Dictionary<string, string>
    {
        ["Баскетбол"] = "bi-basketball",
        ["Волейбол"] = "bi-volleyball",
        ["Футбол"] = "bi-dribbble",
        ["Плавание"] = "bi-water",
        ["Легкая атлетика"] = "bi-person-running",
        ["Теннис"] = "bi-bicycle"
    };
    var icon = Model != null && sportIcons.ContainsKey(Model.SportType) ? sportIcons[Model.SportType] : "bi-trophy";
}

<div class="page-header" style="background: linear-gradient(135deg, #1a1a2e, #16213e);">
    <div class="container">
        <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i>Назад к командам
        </a>
        <h1 class="mb-0"><i class="bi @icon me-2"></i>@Model!.Name</h1>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 100px; height: 100px; background: #f0f4ff;">
                        <i class="bi @icon display-3 text-primary"></i>
                    </div>
                    <h4 class="fw-bold">@Model.Name</h4>
                    <hr>
                    <div class="text-start">
                        <p class="mb-2"><i class="bi bi-sport text-primary me-2"></i><strong>Вид спорта:</strong> @Model.SportType</p>
                        <p class="mb-2"><i class="bi bi-person-badge text-primary me-2"></i><strong>Тренер:</strong> @Model.CoachName</p>
                        <p class="mb-2"><i class="bi bi-people text-primary me-2"></i><strong>Спортсменов:</strong> @Model.Athletes.Count</p>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <hr>
                            <p class="text-muted small mb-0">@Model.Description</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-people text-success me-2"></i>Состав команды</h4>
                </div>
                <div class="card-body">
                    @if (Model.Athletes.Any())
                    {
                        <div class="row">
                            @foreach (var athlete in Model.Athletes)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card bg-light border-0 h-100">
                                        <div class="card-body d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(athlete.PhotoUrl))
                                            {
                                                <img src="@athlete.PhotoUrl" alt="@athlete.FirstName @athlete.LastName" 
                                                     class="rounded-circle shadow-sm" style="width: 60px; height: 60px; object-fit: cover; flex-shrink: 0;">
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary shadow-sm" 
                                                     style="width: 60px; height: 60px; flex-shrink: 0;">
                                                    <span class="text-white fw-bold">@athlete.FirstName[0]@athlete.LastName[0]</span>
                                                </div>
                                            }
                                            <div class="min-w-0">
                                                <h6 class="mb-0 fw-bold">@athlete.FirstName @athlete.LastName</h6>
                                                <small class="text-muted">@athlete.Group</small>
                                                <br>
                                                <a asp-controller="Athlete" asp-action="Details" asp-route-id="@athlete.Id" class="small fw-bold">Подробнее <i class="bi bi-arrow-right"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-people display-4 text-muted"></i>
                            <p class="text-muted mt-2">Нет спортсменов в команде</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-trophy text-warning me-2"></i>Достижения команды</h4>
                </div>
                <div class="card-body">
                    @if (Model.TeamAchievements.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var achievement in Model.TeamAchievements.OrderByDescending(a => a.Date))
                            {
                                <div class="list-group-item border-0 bg-light rounded-3 mb-2">
                                    <div class="d-flex w-100 justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1 fw-bold">@achievement.Title</h6>
                                            <div class="d-flex gap-2">
                                                <span class="badge bg-primary">@achievement.SportType</span>
                                                <span class="badge bg-warning text-dark">@achievement.Place</span>
                                            </div>
                                        </div>
                                        <small class="text-muted"><i class="bi bi-calendar me-1"></i>@achievement.Date.ToString("dd.MM.yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-trophy display-4 text-muted"></i>
                            <p class="text-muted mt-2">Нет достижений команды</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>