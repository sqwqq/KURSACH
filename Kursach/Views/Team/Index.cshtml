@model IEnumerable<Kursach.Models.Team>

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success mb-2 fs-6 px-3 py-1">Наши команды</span>
                <h1 class="mb-0"><i class="bi bi-flag me-2"></i>Команды</h1>
            </div>
        </div>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-flag display-4 d-block mb-3 text-muted"></i>
            <h4 class="fw-bold">Команды не найдены</h4>
        </div>
    }

    <div class="row">
        @foreach (var team in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm overflow-hidden">
                    <div class="card-body text-center p-4">
                        <h4 class="card-title fw-bold mb-3">@team.Name</h4>
                        <div class="d-flex justify-content-center gap-3 mb-3">
                            <div class="text-center px-3 py-2 bg-light rounded-3">
                                <small class="text-muted d-block">Вид спорта</small>
                                <span class="fw-bold small">@team.SportType</span>
                            </div>
                            <div class="text-center px-3 py-2 bg-light rounded-3">
                                <small class="text-muted d-block">Спортсменов</small>
                                <span class="fw-bold small">@team.Athletes.Count</span>
                            </div>
                        </div>
                        <p class="card-text text-muted small mb-2">
                            <i class="bi bi-person-badge me-1"></i>@team.CoachName
                        </p>
                        @if (!string.IsNullOrEmpty(team.Description))
                        {
                            <p class="card-text text-muted small">@team.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-white border-0 pt-0 text-center pb-4">
                        <a asp-action="Details" asp-route-id="@team.Id" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-info-circle me-1"></i>Подробнее
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>