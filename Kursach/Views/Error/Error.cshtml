@{
    ViewData["Title"] = ViewBag.Message;
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="py-5">
                <i class="bi @ViewBag.Icon display-1 text-muted mb-4 d-block" style="font-size: 6rem;"></i>
                <h1 class="display-1 fw-bold text-muted mb-3">@ViewBag.StatusCode</h1>
                <h3 class="fw-bold mb-3">@ViewBag.Message</h3>
                <p class="text-muted mb-4">Извините, что-то пошло не так. Попробуйте вернуться на главную страницу.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-warning btn-lg px-5">
                    <i class="bi bi-house-door me-2"></i>На главную
                </a>
            </div>
        </div>
    </div>
</div>
