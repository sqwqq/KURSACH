@model IEnumerable<Kursach.Models.News>

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="mb-0"><i class="bi bi-newspaper me-2"></i>Новости</h1>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <form asp-action="Index" method="get" class="mb-4">
        <div class="card">
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted mb-1">Категория</label>
                        <select name="category" class="form-select" asp-items="ViewBag.Categories">
                            <option value="">Все категории</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-filter me-1"></i>Фильтр
                        </button>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Сброс</a>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-newspaper display-4 d-block mb-3 text-muted"></i>
            <h4 class="fw-bold">Новости не найдены</h4>
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="position-relative">
                        @if (item.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 z-1">
                                <i class="bi bi-star-fill me-1"></i>Важное
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 220px;">
                                <i class="bi bi-newspaper display-3 text-muted"></i>
                            </div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">@item.Category</span>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@item.Date.ToString("dd.MM.yyyy")
                            </small>
                        </div>
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <p class="card-text text-muted flex-grow-1">@(item.Content.Length > 120 ? item.Content.Substring(0, 120) + "..." : item.Content)</p>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary px-4">
                                <i class="bi bi-book me-1"></i>Читать далее
                            </a>
                            @if (ViewBag.IsAdmin == true)
                            {
                                <a asp-controller="AdminNews" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
