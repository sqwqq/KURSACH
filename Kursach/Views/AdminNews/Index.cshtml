@model IEnumerable<Kursach.Models.News>

@{
    ViewData["Title"] = "Управление новостями";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="mb-0"><i class="bi bi-newspaper me-2"></i>Новости</h1>
            </div>
            <a asp-action="Create" class="btn btn-info text-white px-4">
                <i class="bi bi-plus-lg me-1"></i>Добавить
            </a>
        </div>
    </div>
</div>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4" style="width: 60px;">Фото</th>
                            <th>Заголовок</th>
                            <th>Категория</th>
                            <th>Дата</th>
                            <th class="text-end pe-4" style="width: 150px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var news in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(news.ImageUrl))
                                    {
                                        <img src="@news.ImageUrl" alt="" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center rounded bg-light" style="width: 50px; height: 50px;">
                                            <i class="bi bi-newspaper text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold">
                                    @(news.Title.Length > 40 ? news.Title.Substring(0, 40) + "..." : news.Title)
                                    @if (news.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">★</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@news.Category</span>
                                </td>
                                <td><small class="text-muted"><i class="bi bi-calendar me-1"></i>@news.Date.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a asp-action="Details" asp-route-id="@news.Id" class="btn btn-sm btn-outline-info" title="Просмотр">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@news.Id" class="btn btn-sm btn-outline-primary" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@news.Id" class="btn btn-sm btn-outline-danger" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Назад в админ-панель
        </a>
    </div>
</div>
