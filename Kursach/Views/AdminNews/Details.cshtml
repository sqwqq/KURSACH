@model Kursach.Models.News

@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-12">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid mb-4 w-100 rounded" alt="@Model.Title" style="max-height: 400px; object-fit: cover;">
        }
        
        <div class="d-flex gap-2 mb-3">
            <span class="badge bg-primary">@Model.Category</span>
            @if (Model.IsFeatured)
            {
                <span class="badge bg-warning">Избранное</span>
            }
        </div>
        
        <h1>@Model.Title</h1>
        <p class="text-muted">@Model.Date.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</p>
        
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <p style="font-size: 1.1rem;">@Model.Content</p>
            </div>
        </div>

        @if (Model.Athlete != null)
        {
            <div class="card border-info mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Связанный спортсмен</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Athlete.FirstName @Model.Athlete.LastName - @Model.Athlete.Group</p>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Назад к списку
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="bi bi-pencil me-1"></i>Редактировать
    </a>
</div>