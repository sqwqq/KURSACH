@model IEnumerable<Kursach.Models.Achievement>

@{
    ViewData["Title"] = "Управление достижениями";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="mb-0"><i class="bi bi-trophy me-2"></i>Достижения</h1>
            </div>
            <a asp-action="Create" class="btn btn-warning px-4">
                <i class="bi bi-plus-lg me-1"></i>Добавить
            </a>
        </div>
    </div>
</div>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Название</th>
                            <th>Вид спорта</th>
                            <th>Место</th>
                            <th>Спортсмен</th>
                            <th>Дата</th>
                            <th class="text-end pe-4" style="width: 120px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var achievement in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@achievement.Title</td>
                                <td><span class="badge bg-primary">@achievement.SportType</span></td>
                                <td>
                                    @{
                                        var placeNum = 0;
                                        var placeStr = achievement.Place ?? "";
                                        if (!string.IsNullOrEmpty(placeStr))
                                            int.TryParse(placeStr.Split(' ')[0], out placeNum);
                                    }
                                    @if (placeNum == 1)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            <i class="bi bi-trophy-fill me-1"></i>@achievement.Place
                                        </span>
                                    }
                                    else if (placeNum == 2)
                                    {
                                        <span class="badge bg-secondary text-white px-3 py-2">
                                            <i class="bi bi-star-fill me-1"></i>@achievement.Place
                                        </span>
                                    }
                                    else if (placeNum == 3)
                                    {
                                        <span class="badge bg-danger text-white px-3 py-2">
                                            <i class="bi bi-award-fill me-1"></i>@achievement.Place
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info px-3 py-2">@achievement.Place</span>
                                    }
                                </td>
                                <td><small>@achievement.Athlete?.FirstName @achievement.Athlete?.LastName</small></td>
                                <td><small class="text-muted"><i class="bi bi-calendar me-1"></i>@achievement.Date.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@achievement.Id" class="btn btn-sm btn-outline-primary" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@achievement.Id" class="btn btn-sm btn-outline-danger" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Назад в админ-панель
        </a>
    </div>
</div>
