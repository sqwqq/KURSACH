@model Kursach.Models.Achievement

@{
    ViewData["Title"] = "Удалить достижение";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Подтверждение удаления
                </h4>
            </div>
            <div class="card-body">
                <p>Вы уверены, что хотите удалить это достижение?</p>
                
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@Model.Title</h5>
                        <p class="card-text">
                            <strong>Вид спорта:</strong> @Model.SportType<br>
                            <strong>Место:</strong> @Model.Place<br>
                            <strong>Дата:</strong> @Model.Date.ToString("dd.MM.yyyy")
                        </p>
                    </div>
                </div>
                
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Удалить
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>