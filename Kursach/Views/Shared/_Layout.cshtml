<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PGEC Sports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        * { scroll-behavior: smooth; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8f9fa;
            background-image: 
                linear-gradient(45deg, rgba(30, 60, 114, 0.03) 25%, transparent 25%),
                linear-gradient(-45deg, rgba(30, 60, 114, 0.03) 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, rgba(30, 60, 114, 0.03) 75%),
                linear-gradient(-45deg, transparent 75%, rgba(30, 60, 114, 0.03) 75%);
            background-size: 20px 20px;
            background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
        }
        main { flex: 1; }
        main > .container { padding-top: 2rem; padding-bottom: 2rem; }
        .navbar {
            background: #1a2a5e !important;
            padding: 0.5rem 0;
            border-bottom: 3px solid #f59e0b;
        }
        .navbar-brand { font-size: 1.35rem; letter-spacing: 0.5px; }
        .nav-link { font-weight: 500; padding: 0.5rem 1rem !important; }
        .nav-link:hover { background: rgba(255,255,255,0.1); }
        .nav-link.active { background: rgba(255,255,255,0.15) !important; }
        .page-header {
            background: #1a2a5e;
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-bottom: 3px solid rgba(245, 158, 11, 0.3);
            position: relative;
        }
        .page-header::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 80px;
            height: 3px;
            background: #f59e0b;
        }
        .page-header h1 { margin: 0; font-weight: 600; }
        footer {
            background: #1a1a2e;
            margin-top: auto;
            border-top: 3px solid rgba(245, 158, 11, 0.15);
        }
        footer a:hover { color: #f59e0b !important; text-decoration: underline !important; }
        .card { border-radius: 0.5rem; border-color: #e9ecef; }
        .card .card-img-top { border-radius: 0.5rem 0.5rem 0 0; }
        .card-header:not(.bg-primary):not(.bg-warning):not(.bg-danger):not(.bg-info):not(.bg-dark) {
            border-bottom: 2px solid #f59e0b;
        }
        .btn { border-radius: 0.375rem; }
        .table { border-radius: 0.5rem; overflow: hidden; }
        .form-control, .form-select { border-radius: 0.375rem; }
        .section-title {
            display: inline-block;
            border-bottom: 3px solid #f59e0b;
            padding-bottom: 0.5rem;
        }
        @@media (max-width: 991px) {
            .navbar-collapse { background: #1a2a5e; padding: 1rem; margin-top: 0.5rem; }
        }
        @@media (max-width: 576px) {
            main > .container { padding-top: 1rem; padding-bottom: 1rem; }
            .page-header { padding: 1.25rem 0; margin-bottom: 1rem; }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-trophy-fill me-2"></i>PGEC Sports
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Athlete" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Спортсмены
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Team" asp-action="Index">
                                <i class="bi bi-flag me-1"></i>Команды
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Achievement" asp-action="Index">
                                <i class="bi bi-award me-1"></i>Достижения
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">
                                <i class="bi bi-newspaper me-1"></i>Новости
                            </a>
                        </li>
                        @{
                            var isAdmin = Context.Session.GetString("IsAdmin") == "true";
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear me-1"></i>Админ
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Панель</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminAthlete" asp-action="Index"><i class="bi bi-people me-2"></i>Спортсмены</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminAchievement" asp-action="Index"><i class="bi bi-trophy me-2"></i>Достижения</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminNews" asp-action="Index"><i class="bi bi-newspaper me-2"></i>Новости</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Admin" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Выход</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-white py-4">
        <div class="container">
            <div class="row g-3">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-2">
                        <i class="bi bi-trophy-fill me-2"></i>PGEC Sports 2026
                    </h5>
                    <p class="mb-1 text-white-50 small">Полоцкий государственный экономический колледж — спортивные достижения студентов</p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-2">Разделы</h6>
                    <div class="d-flex flex-column gap-1">
                        <a asp-controller="Athlete" asp-action="Index" class="text-white-50 text-decoration-none small">Спортсмены</a>
                        <a asp-controller="Team" asp-action="Index" class="text-white-50 text-decoration-none small">Команды</a>
                        <a asp-controller="Achievement" asp-action="Index" class="text-white-50 text-decoration-none small">Достижения</a>
                        <a asp-controller="News" asp-action="Index" class="text-white-50 text-decoration-none small">Новости</a>
                    </div>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-2">Контакты</h6>
                    <div class="d-flex flex-column gap-1">
                        <small class="text-white-50"><i class="bi bi-geo-alt me-2"></i>г. Полоцк, ул. Строителей, 15</small>
                        <small class="text-white-50"><i class="bi bi-envelope me-2"></i>sports@pgec.edu</small>
                        <small class="text-white-50"><i class="bi bi-telephone me-2"></i>+7 (495) 123-45-67</small>
                    </div>
                </div>
            </div>
            <hr class="my-3 border-secondary">
            <div class="text-center">
                <small class="text-white-50">© 2026 PGEC Sports. Все права защищены.</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
